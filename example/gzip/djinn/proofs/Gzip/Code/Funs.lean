def solution.prefix3 (a : Std.U32) (b : Std.U32) : Result Std.Usize := do
  let i ← lift (a &&& 255#u32)
  let i1 ← lift (b &&& 255#u32)
  let first ← if i = i1
              then ok 1#usize
              else ok 0#usize
  let i2 ← lift (a &&& 65535#u32)
  let i3 ← lift (b &&& 65535#u32)
  let second ← if i2 = i3
               then ok 1#usize
               else ok 0#usize
  let i4 ← lift (a &&& 16777215#u32)
  let i5 ← lift (b &&& 16777215#u32)
  let third ← if i4 = i5
              then ok 1#usize
              else ok 0#usize
  let i6 ← first + second
  i6 + third

